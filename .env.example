# Copy this file to .env and fill in real values. .env is gitignored.

# Backend API origin (Nest), not the frontend SPA.
API_BASE_URL=https://api.sparkscout.com

# Primary creator account used by authedApi / authSession fixtures.
TEST_EMAIL=
TEST_PASSWORD=

# Second creator account — for cross-user / IDOR tests.
TEST_EMAIL_2=
TEST_PASSWORD_2=

# Brand-role accounts — for campaigns/applications/products endpoints that are brand-only.
TEST_BRAND_EMAIL=
TEST_BRAND_PASSWORD=
TEST_BRAND_EMAIL_2=
TEST_BRAND_PASSWORD_2=

# Agency-role accounts — for agency-clients/agency-profile/agency-team-invitations endpoints.
TEST_AGENCY_EMAIL=
TEST_AGENCY_PASSWORD=
TEST_AGENCY_EMAIL_2=
TEST_AGENCY_PASSWORD_2=

# Only needed for the change-email test — a second address the OTP gets sent to.
# TEST_EMAIL_CHANGE_TARGET=

# Gmail API OAuth (installed-app flow) — used to read OTP codes / confirmation
# links out of the inbox that receives mail for TEST_EMAIL.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
